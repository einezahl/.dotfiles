# SSH keys via keychain. Must run before the Powerlevel10k instant prompt
# below, which swallows the console input keychain needs for passphrase
# prompts. See scripts/ssh_keychain.sh for the details.
source "$HOME/.dotfiles/scripts/ssh_keychain.sh"

# Enable Powerlevel10k instant prompt. Must stay near the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# History — flush after every command so entries survive non-graceful exits
# (e.g. zsh inside a detached tmux session being killed at reboot).
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=200000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Completion
autoload -Uz compinit && compinit

# vi-style command-line editing
bindkey -v

# Ctrl-F runs the tmux sessionizer (the same script as tmux's prefix + f).
tmux-sessionizer-widget() {
  BUFFER="$HOME/.dotfiles/scripts/tmux_sessionizer.sh"
  zle accept-line
}
zle -N tmux-sessionizer-widget
bindkey -M viins '^F' tmux-sessionizer-widget
bindkey -M vicmd '^F' tmux-sessionizer-widget

export NVM_DIR="$HOME/.nvm"
[ -s "/usr/local/opt/nvm/nvm.sh" ] && . "/usr/local/opt/nvm/nvm.sh"

alias ll='ls -alF'
alias cd=z
alias ..="cd .."
alias spy="source .venv/bin/activate"
alias ppy='export PYTHONPATH=$PWD:$PYTHONPATH'
alias copy="xclip -sel clip"

# Compatibility for logging into a remote terminal
alias ssh="TERM=xterm-256color ssh"

eval "$(zoxide init zsh)"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export TERM=xterm-256color
export EDITOR=nvim
export VISUAL=nvim
export DOCKER_HOST=unix://$HOME/.docker/desktop/docker.sock
export CLAUDE_CODE_NO_FLICKER=1

# Go toolchain and user-installed Go binaries
export PATH="$PATH:/usr/local/go/bin:$HOME/go/bin"

# opencode CLI
export PATH="$HOME/.opencode/bin:$PATH"

# MATLAB — only installed on some machines.
[ -d "$HOME/tools/matlab_2026a/bin" ] && export PATH="$PATH:$HOME/tools/matlab_2026a/bin"

# Homebrew/Linuxbrew — guarded so machines without it don't error every shell.
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && \
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# Node via fnm — the apt Node is too old for npm-based tools like Mason's
# language servers. After Homebrew so fnm's Node wins. Guarded for machines
# without fnm.
if [ -x "$HOME/.local/share/fnm/fnm" ]; then
  export PATH="$HOME/.local/share/fnm:$PATH"
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# Powerlevel10k theme (cloned into ~/.dotfiles/zsh/ by install.sh — gitignored,
# so a fresh machine that skipped install.sh won't have it). Warn loudly rather
# than failing silently to a bare prompt.
P10K_THEME="$HOME/.dotfiles/zsh/powerlevel10k/powerlevel10k.zsh-theme"
if [ -f "$P10K_THEME" ]; then
  source "$P10K_THEME"
else
  echo "p10k theme missing ($P10K_THEME) — run ~/.dotfiles/install.sh" >&2
fi

# Generated by `p10k configure`. Run it once per machine to customize the prompt.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
