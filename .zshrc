# zsh entry point, shared by all machines. Order:
#   shell/common.zsh       everything shared
#   shell/macos.zsh        macOS only        (by $OSTYPE)
#   shell/linux.zsh        Linux only
#   machine/shell.zsh      this machine only (machine -> machines/<name>, set by ./setup)
#   ~/.config/localenv/*   untracked secrets and overrides, last so they win

# powerlevel10k instant prompt, must stay close to the top. Anything that
# needs console input (password prompts, [y/n] questions) goes below it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export DOTFILES="$HOME/.dotfiles"

# Tools that honor XDG read their config straight from this repo
export XDG_CONFIG_HOME="$DOTFILES"

# Name of this machine, taken from the gitignored `machine` symlink
if [[ -L "$DOTFILES/machine" ]]; then
    export DOTFILES_MACHINE="$(basename "$(readlink "$DOTFILES/machine")")"
fi

source "$DOTFILES/shell/common.zsh"

case "$OSTYPE" in
    darwin*) source "$DOTFILES/shell/macos.zsh" ;;
    linux*)  source "$DOTFILES/shell/linux.zsh" ;;
esac

[[ -r "$DOTFILES/machine/shell.zsh" ]] && source "$DOTFILES/machine/shell.zsh"

# completion
[[ -d ~/.zfunc ]] && fpath+=~/.zfunc
autoload -Uz compinit && compinit

eval "$(zoxide init zsh)"
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# powerlevel10k: first match wins. Install with one of
#   brew install powerlevel10k                                   (macOS)
#   git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k
for p10k in \
    /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme \
    /usr/share/powerlevel10k/powerlevel10k.zsh-theme \
    /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
    "$HOME/powerlevel10k/powerlevel10k.zsh-theme" \
    "$HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme" \
    "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k/powerlevel10k.zsh-theme"; do
    if [[ -r "$p10k" ]]; then
        source "$p10k"
        break
    fi
done
unset p10k
# prompt layout, generated by `p10k configure`. The tracked copy in this repo
# is shared by all machines; a local ~/.p10k.zsh is only used when the repo
# has none. To update the shared one, run `p10k configure` and then
# `mv ~/.p10k.zsh "$DOTFILES/.p10k.zsh"`.
if [[ -f "$DOTFILES/.p10k.zsh" ]]; then
    source "$DOTFILES/.p10k.zsh"
elif [[ -f ~/.p10k.zsh ]]; then
    source ~/.p10k.zsh
fi

# Secrets and overrides that are not tracked in git
LOCALENV="$HOME/.config/localenv/"
if [[ -d "$LOCALENV" ]]; then
    for i in $(find -L "$LOCALENV" -type f); do
        source "$i"
    done
fi
