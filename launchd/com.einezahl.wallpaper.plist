<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cycle the desktop wallpaper every hour (scripts/wallpaper).
     Installed by ./setup into ~/Library/LaunchAgents with __HOME__ replaced.
     Change the interval here (seconds) and rerun ./setup. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.einezahl.wallpaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/wallpaper</string>
        <string>next</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardErrorPath</key>
    <string>/tmp/wallpaper.log</string>
</dict>
</plist>
