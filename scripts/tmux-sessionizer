#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$({
        {
            find ~/dev/code_review ~/dev/cv ~/dev/data_science_course ~/dev/experiments \
                 ~/dev/hashcode ~/dev/keyboard_layouts ~/dev/playground ~/dev/projects \
                 ~/dev/swift_projects ~/dev/tools \
                 -maxdepth 2 -type d -name .git -prune
            find ~/dev/apps ~/dev/competitions ~/dev/ml ~/dev/solidity_projects ~/dev/whoishydra \
                 -maxdepth 3 -type d -name .git -prune
            find ~/dev/crypto ~/dev/lectures ~/dev/phd ~/dev/tutorials \
                 -maxdepth 4 -type d -name .git -prune
        } 2>/dev/null | sed 's|/\.git$||'
        echo "$HOME/obsidian/phd"
    } | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name
