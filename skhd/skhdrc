# skhd config — ported from .aerospace.toml / i3.
# Note: skhd hot-reloads this file on save; yabai needs alt+shift-c (below).
# 0x29 is the keycode for semicolon (skhd has no named key for it).

# ---- launchers ----
alt - return : open -na kitty --args --single-instance -d ~
cmd + shift - s : open -n -a Safari
# app launcher, like rofi in i3
cmd - d : open -a Sol

# ---- focus, i3 home-row style (falls back to next display at the edge) ----
alt - j : yabai -m window --focus west  || yabai -m display --focus west
alt - k : yabai -m window --focus south || yabai -m display --focus south
alt - l : yabai -m window --focus north || yabai -m display --focus north
alt - 0x29 : yabai -m window --focus east || yabai -m display --focus east

# ---- move windows ----
alt + shift - j : yabai -m window --swap west
alt + shift - k : yabai -m window --swap south
alt + shift - l : yabai -m window --swap north
alt + shift - 0x29 : yabai -m window --swap east

# ---- splits: set where the next window opens (BSP equivalent of i3 split) ----
alt - h : yabai -m window --insert east
alt - v : yabai -m window --insert south

# fullscreen
alt - f : yabai -m window --toggle zoom-fullscreen

# ---- layouts: stack ≈ i3 stacking/tabbed, bsp = tiled ----
alt - s : yabai -m space --layout stack
alt - w : yabai -m space --layout stack
alt - e : yabai -m space --layout bsp

# floating toggle
alt + shift - space : yabai -m window --toggle float

# ---- spaces (requires the scripting addition / SIP partially disabled) ----
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7
cmd - 8 : yabai -m space --focus 8
cmd - 9 : yabai -m space --focus 9
cmd - 0 : yabai -m space --focus 10

cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7
cmd + shift - 8 : yabai -m window --space 8
cmd + shift - 9 : yabai -m window --space 9
cmd + shift - 0 : yabai -m window --space 10

# restart yabai (skhd reloads itself automatically)
alt + shift - c : yabai --restart-service
# ---- resize mode, i3-style (@ swallows unbound keys while in the mode) ----
:: default
:: resize @
alt - r ; resize
resize < h : yabai -m window --resize left:-50:0  || yabai -m window --resize right:-50:0
resize < j : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50
resize < k : yabai -m window --resize bottom:0:-50 || yabai -m window --resize top:0:-50
resize < l : yabai -m window --resize right:50:0  || yabai -m window --resize left:50:0
resize < return ; default
resize < escape ; default
