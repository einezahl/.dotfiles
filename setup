#!/usr/bin/env bash
# Link the tracked configs into $HOME and record which machine this is.
#
#   ./setup [machine]
#
# machine is a directory name under machines/. Without an argument the
# previously chosen machine is kept, otherwise a menu is shown. The choice
# is stored as the gitignored symlink `machine -> machines/<name>`, which
# .zshrc, i3, polybar, rofi, alacritty and kitty include from.
#
# Existing files at a link target are moved to ~/.config/old_config/<timestamp>/.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$HOME/.config"
BACKUP="$CONFIG/old_config/$(date +%Y-%m-%d_%H-%M-%S)"

# --- which machine -----------------------------------------------------------

machines=()
for d in "$DOTFILES"/machines/*/; do
    machines+=("$(basename "$d")")
done

choose_machine() {
    if command -v fzf >/dev/null 2>&1; then
        printf '%s\n' "${machines[@]}" | fzf --prompt='machine> ' --height=10
    else
        PS3='machine> '
        select m in "${machines[@]}"; do
            [ -n "$m" ] && echo "$m" && break
        done
    fi
}

machine="${1:-}"
if [ -z "$machine" ] && [ -L "$DOTFILES/machine" ]; then
    machine="$(basename "$(readlink "$DOTFILES/machine")")"
fi
# The i3 machines used to record 4k/hd in a .machine file; carry that over once.
if [ -z "$machine" ] && [ -f "$DOTFILES/.machine" ]; then
    case "$(tr -d '[:space:]' < "$DOTFILES/.machine")" in
        4k) machine=i3-4k ;;
        hd) machine=i3-hd ;;
    esac
fi
if [ -z "$machine" ]; then
    machine="$(choose_machine)"
fi
if [ -z "$machine" ] || [ ! -d "$DOTFILES/machines/$machine" ]; then
    echo "unknown machine '$machine'. Available: ${machines[*]}" >&2
    exit 1
fi

ln -sfn "machines/$machine" "$DOTFILES/machine"
echo "machine: $machine"

# the .machine flag and the per-tool links it selected are replaced by `machine`
for f in .machine i3/machine/current.conf rofi/machine.rasi polybar/cuts/machine.ini kitty/machine.conf; do
    if [ -e "$DOTFILES/$f" ] || [ -L "$DOTFILES/$f" ]; then
        rm "$DOTFILES/$f"
        echo "removed old machine flag $f"
    fi
done
rmdir "$DOTFILES/i3/machine" 2>/dev/null || true

# --- linking -----------------------------------------------------------------

# link <path relative to this repo> <target>
link() {
    local src="$DOTFILES/$1" dst="$2"
    mkdir -p "$(dirname "$dst")"
    if [ -L "$dst" ]; then
        rm "$dst"
    elif [ -e "$dst" ]; then
        mkdir -p "$BACKUP"
        mv "$dst" "$BACKUP/$(basename "$dst")"
        echo "moved existing $dst to $BACKUP/"
    fi
    ln -s "$src" "$dst"
}

# bash is no longer used; drop links left over from earlier versions of this repo
for f in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -L "$f" ] && [[ "$(readlink "$f")" == "$DOTFILES"/* ]]; then
        rm "$f"
        echo "removed stale link $f"
    fi
done

# shared by all machines
link .zshrc                   "$HOME/.zshrc"
link .zprofile                "$HOME/.zprofile"
link .tmux.conf               "$HOME/.tmux.conf"
link alacritty.toml           "$CONFIG/alacritty/alacritty.toml"
link kitty                    "$CONFIG/kitty"
link nvim                     "$CONFIG/nvim"
link yazi                     "$CONFIG/yazi"
link claude/CLAUDE.md         "$HOME/.claude/CLAUDE.md"
link claude/ml-projects.md    "$HOME/.claude/ml-projects.md"
for s in "$DOTFILES"/scripts/*; do
    link "scripts/$(basename "$s")" "$HOME/.local/bin/$(basename "$s")"
done

case "$OSTYPE" in
    darwin*)
        link yabai           "$CONFIG/yabai"
        link skhd            "$CONFIG/skhd"
        # wallpaper rotation on macOS is done in System Settings > Wallpaper
        # (add the folder, "change picture" hourly); scripts/wallpaper is for i3
        ;;
    linux*)
        for d in i3 polybar rofi dunst picom zathura; do
            link "$d" "$CONFIG/$d"
        done

        # Shadow the snap's Obsidian desktop entry (same file name, higher XDG
        # precedence) so rofi and obsidian:// links go through the scaling
        # wrapper. Written rather than linked because Exec needs an absolute path.
        mkdir -p "$HOME/.local/share/applications"
        cat > "$HOME/.local/share/applications/obsidian_obsidian.desktop" <<EOF
[Desktop Entry]
Name=Obsidian
Exec=$DOTFILES/scripts/obsidian.sh %U
Terminal=false
Type=Application
Icon=/snap/obsidian/current/meta/gui/obsidian.png
StartupWMClass=md.obsidian.Obsidian
Comment=Obsidian
MimeType=x-scheme-handler/obsidian;
Categories=Office;
EOF

        # hourly wallpaper change: systemd user timer
        if command -v systemctl >/dev/null 2>&1; then
            link systemd/user/wallpaper.service "$CONFIG/systemd/user/wallpaper.service"
            link systemd/user/wallpaper.timer   "$CONFIG/systemd/user/wallpaper.timer"
            systemctl --user daemon-reload
            systemctl --user enable --now wallpaper.timer
            echo "enabled systemd timer wallpaper.timer"
        fi
        ;;
esac

echo "done"
