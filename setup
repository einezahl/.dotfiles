export XDG_CONFIG_HOME="$HOME"/.config
mkdir -p "$XDG_CONFIG_HOME"/bash
mkdir -p "$XDG_CONFIG_HOME"/alacritty

mkdir -p "$HOME"/.local/bin

ln -sf "$PWD/alacritty.toml" "$XDG_CONFIG_HOME"/alacritty/alacritty.toml
ln -sfn "$PWD/kitty" "$XDG_CONFIG_HOME"/kitty
ln -sfn "$PWD/yazi" "$XDG_CONFIG_HOME"/yazi
ln -sfn "$PWD/yabai" "$XDG_CONFIG_HOME"/yabai
ln -sfn "$PWD/skhd" "$XDG_CONFIG_HOME"/skhd
ln -sf "$PWD/.bash_profile" "$HOME"/.bash_profile
ln -sf "$PWD/.bashrc" "$HOME"/.bashrc
ln -sf "$PWD/.tmux.conf" "$HOME"/.tmux.conf
ln -sf "$PWD/nvim" "$XDG_CONFIG_HOME"/nvim
ln -sf "$PWD/scripts/tmux-sessionizer" "$HOME"/.local/bin/tmux-sessionizer

