#!/usr/bin/env bash
# Link the tracked configs into $HOME and record which machine this is.
#
#   ./setup [machine]
#
# machine is a directory name under machines/. Without an argument the
# previously chosen machine is kept, otherwise a menu is shown. The choice
# is stored as the gitignored symlink `machine -> machines/<name>`, which
# .bashrc, i3, polybar, alacritty and kitty include from.
#
# Existing files at a link target are moved to ~/.config/old_config/<timestamp>/.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$HOME/.config"
BACKUP="$CONFIG/old_config/$(date +%Y-%m-%d_%H-%M-%S)"

# --- which machine -----------------------------------------------------------

machines=()
for d in "$DOTFILES"/machines/*/; do
    machines+=("$(basename "$d")")
done

choose_machine() {
    if command -v fzf >/dev/null 2>&1; then
        printf '%s\n' "${machines[@]}" | fzf --prompt='machine> ' --height=10
    else
        PS3='machine> '
        select m in "${machines[@]}"; do
            [ -n "$m" ] && echo "$m" && break
        done
    fi
}

machine="${1:-}"
if [ -z "$machine" ] && [ -L "$DOTFILES/machine" ]; then
    machine="$(basename "$(readlink "$DOTFILES/machine")")"
fi
if [ -z "$machine" ]; then
    machine="$(choose_machine)"
fi
if [ -z "$machine" ] || [ ! -d "$DOTFILES/machines/$machine" ]; then
    echo "unknown machine '$machine'. Available: ${machines[*]}" >&2
    exit 1
fi

ln -sfn "machines/$machine" "$DOTFILES/machine"
echo "machine: $machine"

# --- linking -----------------------------------------------------------------

# link <path relative to this repo> <target>
link() {
    local src="$DOTFILES/$1" dst="$2"
    mkdir -p "$(dirname "$dst")"
    if [ -L "$dst" ]; then
        rm "$dst"
    elif [ -e "$dst" ]; then
        mkdir -p "$BACKUP"
        mv "$dst" "$BACKUP/$(basename "$dst")"
        echo "moved existing $dst to $BACKUP/"
    fi
    ln -s "$src" "$dst"
}

# bash is no longer used; drop links left over from earlier versions of this repo
for f in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -L "$f" ] && [[ "$(readlink "$f")" == "$DOTFILES"/* ]]; then
        rm "$f"
        echo "removed stale link $f"
    fi
done

# shared by all machines
link .zshrc                   "$HOME/.zshrc"
link .zprofile                "$HOME/.zprofile"
link .tmux.conf               "$HOME/.tmux.conf"
link alacritty.toml           "$CONFIG/alacritty/alacritty.toml"
link kitty                    "$CONFIG/kitty"
link nvim                     "$CONFIG/nvim"
link yazi                     "$CONFIG/yazi"
link scripts/tmux-sessionizer "$HOME/.local/bin/tmux-sessionizer"

case "$OSTYPE" in
    darwin*)
        link .aerospace.toml "$HOME/.aerospace.toml"
        link yabai           "$CONFIG/yabai"
        link skhd            "$CONFIG/skhd"
        ;;
    linux*)
        for d in i3 polybar rofi dunst picom; do
            link "$d" "$CONFIG/$d"
        done
        ;;
esac

echo "done"
